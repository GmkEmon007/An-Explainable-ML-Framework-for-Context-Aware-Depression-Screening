    "import os\n",
    "import pandas as pd\n",
    "from dotenv import load_dotenv\n",
    "from gsheet_loader import load_sheet\n",
    "load_dotenv()\n",
    "# Load a Google Sheet\n",
    "url = os.environ[\"GOOGLE_SHEET_URL\"]\n",
    "data = load_sheet(url)\n",
    "df = pd.read_csv(data)\n",
    "df.head()"
   ]
  }
